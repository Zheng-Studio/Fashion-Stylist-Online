# 复制为 backend/.env 后按需填写（.env 不进版本库）

# ---- 数据库 ----
# 本地开发默认 SQLite；部署换 Postgres：postgresql+psycopg://user:pass@host:5432/db
# DATABASE_URL=sqlite:///./data/app.db

# ---- 大模型（OpenAI 兼容协议）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 自动打标要看图；不填则用 LLM_MODEL
# LLM_VISION_MODEL=
# 结构化输出方式：json_schema / json_object / none（按供应商支持程度选）
# LLM_JSON_MODE=json_object

# ---- 生图（OpenAI 兼容协议 images/edits）----
# 不填 BASE_URL / API_KEY 则沿用 LLM 的
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
IMAGE_MODEL=
# 输出尺寸，如 1024x1536；不填由接口默认
# IMAGE_SIZE=
# 换装方式：single = 人物 + 全部单品一次调用；serial = 逐件串行（接口一次只收 2 张图时用）
# TRYON_MODE=single

# ---- 文件存储 ----
# STORAGE_DIR=./data/files
# FILES_URL_PREFIX=/files/

# ---- 登录 / 扣费（对接 Lucimix 前用 dev / ledger）----
# AUTH_MODE=dev
# DEV_DEFAULT_USER=dev
# BILLING_MODE=ledger
