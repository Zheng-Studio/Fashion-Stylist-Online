# 复制为 backend/.env 后按需填写（.env 不进版本库）

# ---- 数据库 ----
# 本地开发默认 SQLite；部署换 Postgres：postgresql+psycopg://user:pass@host:5432/db
# DATABASE_URL=sqlite:///./data/app.db

# ---- 大模型（OpenAI 兼容协议）----
# 填模型服务商提供的 API 根地址（通常以 /v1 结尾）、API 密钥和模型 ID。
# 选款和自动打标共用 LLM_MODEL，所以必须选支持看图的多模态模型。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 结构化输出方式：json_schema / json_object / none（按供应商支持程度选）
# LLM_JSON_MODE=json_object

# ---- 生图（OpenAI 兼容协议 images/generations）----
# 换装是人物照 + 整套单品一次调用。BASE_URL / API_KEY 留空则沿用上面大模型的；模型 ID 按服务商提供值填写。
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
IMAGE_MODEL=
# 输出像素尺寸，具体值须为所选模型支持的尺寸。人物补全、上身效果图、本人照片编辑用它，默认 3:4 竖图。
IMAGE_SIZE=1728x2304
# 单品场景（白底、单品 AI 编辑）请求的尺寸，填一个所选模型支持的方形尺寸（如 2048x2048）。
# 留空则沿用 IMAGE_SIZE；不管模型出什么比例，单品图落盘前都会补成 1280×1280 方图。
# IMAGE_SIZE_SQUARE=

# ---- 文件存储 ----
# STORAGE_DIR=./data/files
# FILES_URL_PREFIX=/files/

# ---- 登录 / 扣费（对接 Lucimix 前用 dev / ledger）----
# AUTH_MODE=dev
# DEV_DEFAULT_USER=dev
# BILLING_MODE=ledger

# ---- 部署相关 ----
# 允许的前端来源（JSON 数组）。Nginx 同源反代 /api、/files 时保持默认 * 即可；
# 前后端不同源时改成实际域名，例如 ["https://your-frontend.example.com"]
# CORS_ORIGINS=["*"]
# 生图后台任务并发线程数（进程内线程池，试穿 + 单品生图共用）。生图主要在等接口，可按模型服务的并发配额调大。
# 线程可以开多个，但进程只能有一个（不能 --workers / 多实例），见 README「部署」
# TASK_WORKERS=4
